# Copy this file to .env and edit as needed.

# ------------------------------------------------------------
# Platform (master) database - holds ONLY the superadmin account
# and the list of barbershops (name, slug, admin login, active
# flag). Never contains any shop's business data.
# ------------------------------------------------------------
MASTER_DATABASE_URL=sqlite:///./master.db

# ------------------------------------------------------------
# Per-tenant databases - by default each barbershop gets its own
# SQLite file under this folder, e.g. tenants_data/my-shop.db.
# ------------------------------------------------------------
TENANTS_DIR=./tenants_data

# Advanced: to use MySQL/PostgreSQL for tenant databases instead
# of per-file SQLite, set a URL *template* with a {slug} placeholder.
# Each barbershop then gets its own database/schema on your server.
# Leave empty to keep the default (one SQLite file per shop).
# TENANT_DATABASE_URL_TEMPLATE=mysql+pymysql://root:password@localhost/barberpro_{slug}

# JWT settings - CHANGE THE SECRET KEY IN PRODUCTION
SECRET_KEY=change-this-to-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# The single platform-owner account (creates/manages barbershops).
# CHANGE THIS PASSWORD before letting anyone else near the server.
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=super123

# Allowed origins for CORS (comma separated), e.g. the React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
